<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\Net10\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>obj\Net10\</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>MeisterGeister</RootNamespace>
    <AssemblyName>DSA MeisterGeister</AssemblyName>
    <ApplicationIcon>Images\Logos\MG_Icon.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <AppConfig>app.net10.config</AppConfig>
    <OutputPath>bin\Net10\$(Configuration)\</OutputPath>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);NO_JINGLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App.xaml.cs;GlobalSuppressions.cs;Daten\**\*.cs;Logic\**\*.cs;Model\**\*.cs;Net\**\*.cs;Properties\**\*.cs;View\**\*.cs;ViewModel\**\*.cs" Exclude="Model\Audio_Theme_Playlist_Poco.cs;Model\Model1*.cs;Model\Pflanze_Gebiet_Poco.cs;Model\Pflanze_Setting_Poco.cs;Model\Service\HeldService.cs;Model\Service\Extensions\**\*.cs;View\AudioPlayer\DropBehavior.cs;View\General\ColorStringToSolidColorBrushConverter.cs;View\General\IsEqualConverter.cs;View\Kampf\Controls\ManöverView.xaml.cs;View\Karte\PirschAnsitzJagdView.xaml.cs;View\Settings\**\*.cs;View\SpielerScreen\Window1.xaml.cs;ViewModel\Bodenplan\Logic\BattlegroundEnemy.cs;ViewModel\Bodenplan\Logic\BattlegroundHero.cs;ViewModel\Generator\NamenGenerator.cs;ViewModel\Generator\PersonenGenerator.cs;ViewModel\Kampf\Logic\Manöver\Abwehraktion.cs;ViewModel\Kampf\Logic\Manöver\Angriffsaktion.cs;ViewModel\Kampf\Logic\Manöver\KeineAktion.cs;ViewModel\Kampf\Logic\Manöver\LängerfristigeHandlung.cs;ViewModel\Karte\RoutingLine.cs;ViewModel\Karte\RoutingLineType.cs;ViewModel\Karte\RoutingPoint.cs;ViewModel\Karte\Logic\RouteDrawingService.cs;ViewModel\Karte\Logic\TravelService.cs;ViewModel\NscGeneratorAlt\NamenGenerator.cs;ViewModel\NscGeneratorAlt\NscGeneratorViewModel.cs;ViewModel\NscGeneratorAlt\PersonenGenerator.cs;ViewModel\NscGeneratorAlt\Factorys\**\*.cs;ViewModel\NscGeneratorAlt\Logic\**\*.cs;ViewModel\Settings\**\*.cs" />
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="View\**\*.xaml" Exclude="View\Kampf\Controls\ManöverView.xaml;View\Karte\PirschAnsitzJagdView.xaml;View\Settings\**\*.xaml;View\SpielerScreen\Window1.xaml" />
    <Page Include="ViewModel\**\*.xaml" />
    <Resource Include="Images\**\*;Fonts\**\*;Daten\Updateskripte\*.sql" Exclude="Images\Karten\**\*" />
    <EmbeddedResource Include="Properties\Resources.resx;View\ZooBotAlt\*.resx" />
    <EntityDeploy Include="Model\MeisterGeisterModel.edmx" />
    <Content Include="Daten\DatabaseDSA.sdf" Link="Daten\DatabaseDSA_Standard.sdf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Daten\Bodenplan\**\*;Daten\Helden\Demohelden\**\*;Daten\meistergeister.kmz;Images\Karten\**\*;Audio\**\*;DereGlobusIndex.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_SqlServer_Compact)\NativeBinaries\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Tests\Compatibility\AudioUpdateAllTests.cs" />
    <Compile Include="Tests\Compatibility\BasarPerformanceTests.cs" />
    <Compile Include="Tests\Compatibility\BattlegroundFacingTests.cs" />
    <Compile Include="Tests\Compatibility\BattlegroundImagePlacementTests.cs" />
    <Compile Include="Tests\Compatibility\BattlegroundLargeMapTests.cs" />
    <Compile Include="Tests\Compatibility\BattlegroundMovementPathTests.cs" />
    <Compile Include="Tests\Compatibility\BattlegroundTokenSizeTests.cs" />
    <Compile Include="Tests\Compatibility\BusyProgressTests.cs" />
    <Compile Include="Tests\Compatibility\KarteZoomTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.5.1" />
    <PackageReference Include="EntityFramework.SqlServerCompact" Version="6.5.1" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.SqlServer.Compact" Version="4.0.8876.1" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="Sparrow.Chart.Wpf" Version="13.1.0.118" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="WPFToolkit" Version="3.5.50211.1" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.3" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="Q42.HueApi" Version="3.15.5" />
    <PackageReference Include="Q42.HueApi.ColorConverters" Version="3.14.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.0" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.0" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.0" />
    <PackageReference Include="ImpromptuInterface" Version="8.1.0" />
    <PackageReference Include="Dynamitey" Version="3.0.3" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Ares.MeisterGeisterPlugin" HintPath="Libs\Ares.MeisterGeisterPlugin.dll" />
    <Reference Include="ArtefaktGenerator" HintPath="Libs\ArtefaktGenerator.dll" />
    <Reference Include="DG-Suche" HintPath="Libs\DG-Suche.dll" />
    <Reference Include="bass.net" HintPath="Audio\BASS\bass.net.dll" />
    <Reference Include="Microsoft.Expression.Effects" HintPath="Libs\Microsoft.Expression.Effects.dll" />
    <Reference Include="Microsoft.Expression.Interactions" HintPath="Libs\Microsoft.Expression.Interactions.dll" />
    <Reference Include="System.Windows.Interactivity" HintPath="Libs\System.Windows.Interactivity.dll" />
    <Reference Include="WPFExtensions" HintPath="Libs\WPFExtensions.dll" />
    <Reference Include="Xceed.Wpf.Toolkit" HintPath="Libs\Xceed.Wpf.Toolkit.dll" />
    <Reference Include="System.Data.SqlServerCe" HintPath="$(PkgMicrosoft_SqlServer_Compact)\lib\net40\System.Data.SqlServerCe.dll" />
    <Reference Include="EntityFramework.SqlServerCompact" HintPath="$(PkgEntityFramework_SqlServerCompact)\lib\net45\EntityFramework.SqlServerCompact.dll" />
    <Reference Include="Sparrow.Chart.Wpf.40" HintPath="$(PkgSparrow_Chart_Wpf)\lib\net40\Sparrow.Chart.Wpf.40.dll" />
    <Reference Include="WPFToolkit" HintPath="$(PkgWPFToolkit)\lib\WPFToolkit.dll" />
    <Reference Include="System.Windows.Controls.Input.Toolkit" HintPath="$(PkgWPFToolkit)\lib\System.Windows.Controls.Input.Toolkit.dll" />
    <Reference Include="System.Windows.Controls.Layout.Toolkit" HintPath="$(PkgWPFToolkit)\lib\System.Windows.Controls.Layout.Toolkit.dll" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
